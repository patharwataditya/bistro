{
	# Nothing sits in front of Caddy, so no upstream proxy is trusted (no trusted_proxies):
	# a client's own X-Forwarded-For is always replaced with the real peer address.
	servers {
		protocols h1 h2 h3
	}
}

{$BISTRO_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 512KB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
		-Via
	}

	handle /api/v1/* {
		reverse_proxy api:8000 {
			header_down -Via
			health_uri /api/v1/health
			health_interval 30s
		}
	}

	handle {
		respond "Bistro API" 200
	}

	log {
		output stdout
		format json
	}
}
