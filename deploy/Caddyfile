{
	# Nothing sits in front of Caddy, so no upstream proxy is trusted (no trusted_proxies):
	# a client's own X-Forwarded-For is always replaced with the real peer address.
	servers {
		protocols h1 h2 h3
	}
}

{$BISTRO_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 512KB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# The web app loads nothing third-party: every script, style, font and API call is same-origin.
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		-Server
		-Via
	}

	handle /api/v1/* {
		reverse_proxy api:8000 {
			header_down -Via
			health_uri /api/v1/health
			health_interval 30s
		}
	}

	# Unknown API paths never fall through to the web app.
	handle /api/* {
		respond 404
	}

	# Bistro Web: a static single-page app built on the operator's machine (deploy.sh).
	# Content-hashed bundles never change. A missing one is a real 404 (never the HTML shell,
	# which a year-long immutable cache would otherwise pin under that URL).
	handle /assets/* {
		root * /srv/web
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		@missing not file
		header @missing Cache-Control "no-store"
		file_server
	}

	@maps path *.map
	handle @maps {
		respond 404
	}

	# Every other path is a client-side route: serve the shell, always revalidated so a deploy
	# is picked up on the next navigation.
	handle {
		root * /srv/web
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
