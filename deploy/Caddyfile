{
	# Nothing sits in front of Caddy, so no upstream proxy is trusted (no trusted_proxies):
	# a client's own X-Forwarded-For is always replaced with the real peer address.
	servers {
		protocols h1 h2 h3
	}
}

{$BISTRO_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 512KB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# The web app loads nothing third-party: every script, style, font and API call is same-origin.
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		-Server
		-Via
	}

	handle /api/v1/* {
		reverse_proxy api:8000 {
			header_down -Via
			health_uri /api/v1/health
			health_interval 30s
		}
	}

	# Unknown API paths never fall through to the web app.
	handle /api/* {
		respond 404
	}

	# Bistro Web: a static single-page app built on the operator's machine (deploy.sh).
	handle {
		root * /srv/web
		@maps path *.map
		respond @maps 404
		# Content-hashed bundles never change; the HTML shell is always revalidated so a deploy
		# is picked up on the next navigation.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
