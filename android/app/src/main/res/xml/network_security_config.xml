<?xml version="1.0" encoding="utf-8"?>
<!-- No build ever sends traffic in cleartext; the HTTP client also refuses non-HTTPS URLs. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
